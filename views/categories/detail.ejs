<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body>
  <header>
    <h1><%= category.name %></h1>

    <nav>
      <a href="/">Home</a>
      <a href="/categories">Categories</a>
      <a href="/games">Games</a>
    </nav>
  </header>

  <main>
    <% if (category.description) { %>
      <p><%= category.description %></p>
    <% } %>

    <h2>Games</h2>

    <% if (games.length === 0) { %>
      <p>There are no games in this category.</p>
    <% } else { %>
      <ul>
        <% games.forEach((game) => { %>
          <li>
            <a href="/games/<%= game.id %>"><%= game.title %></a>
            — $<%= Number(game.price).toFixed(2) %>
            — <%= game.stock_quantity %> in stock
          </li>
        <% }); %>
      </ul>
    <% } %>

    <p>
      <a href="/categories/<%= category.id %>/edit">Edit category</a>
    </p>

    <p>
      <a href="/games/new">Add a game</a>
    </p>
  </main>
</body>
</html>